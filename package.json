{
  "name": "x-graph-harvester",
  "version": "0.1.0",
  "description": "Strictly typed read-only X web GraphQL client with account pooling and resumable output",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli/main.js"
  },
  "bin": {
    "x-graph-harvester": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs --runInBand",
    "test:integration": "RUN_LIVE_TESTS=1 NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs --runInBand tests/integration",
    "check": "npm run format:check && npm run lint && npm run build && npm test -- --runInBand",
    "cli": "node dist/cli/main.js",
    "context": "node scripts/harness/context.mjs",
    "verify": "npm run format:check && npm run lint && npm run build && npm test -- --runInBand && npm run package:check && npm run harness:validate && npm run harness:budget",
    "package:check": "node scripts/package-check.mjs",
    "harness:validate": "python3 scripts/harness/validate.py",
    "harness:budget": "python3 scripts/harness/budget.py"
  },
  "dependencies": {
    "undici": "^7.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^10.6.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.4",
    "ts-jest": "^29.3.4",
    "typescript": "^5.9.3"
  }
}
