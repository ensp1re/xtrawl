{
  "name": "xtrawl",
  "version": "0.1.2",
  "description": "Scrape public X posts, profiles, followers, and following",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "DOCUMENTATION.md",
    "LICENSE",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ensp1re/xtrawl.git"
  },
  "homepage": "https://github.com/ensp1re/xtrawl#readme",
  "bugs": {
    "url": "https://github.com/ensp1re/xtrawl/issues"
  },
  "keywords": [
    "x",
    "twitter",
    "scraper",
    "crawler",
    "typescript"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/main.d.ts",
      "import": "./dist/cli/main.js",
      "default": "./dist/cli/main.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "xtrawl": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs --runInBand",
    "test:integration": "RUN_LIVE_TESTS=1 NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs --runInBand tests/integration",
    "check": "npm run format:check && npm run lint && npm run build && npm test -- --runInBand",
    "cli": "node dist/cli/main.js",
    "context": "node scripts/harness/context.mjs",
    "verify": "npm run format:check && npm run lint && npm run build && npm test -- --runInBand && npm run package:check && npm run harness:validate && npm run harness:budget",
    "package:check": "node scripts/package-check.mjs",
    "harness:validate": "python3 scripts/harness/validate.py",
    "harness:budget": "python3 scripts/harness/budget.py",
    "bench": "npm run build && node scripts/bench.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify",
    "prepare": "husky"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "fetch-socks": "^1.3.3",
    "undici": "^7.22.0",
    "x-client-transaction-id": "^0.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "jest": "^30.5.0",
    "prettier": "^3.9.4",
    "ts-jest": "^29.3.4",
    "typescript": "^5.9.3"
  }
}
